# Адрес сервера (IP или домен)
DEPLOY_HOST=192.168.0.1

# SSH пользователь
DEPLOY_USER=user

# Пароль SSH (если используешь ключи — оставляешь пустым и настраиваешь другой вариант)
DEPLOY_PASSWORD=your_password_here

# Путь к каталогу, куда загружается сборка
REMOTE_DIR=/var/www/docs

# Относительный путь к папке сборки (без начального слеша)
DIST_DIR=docs/.vitepress/dist
