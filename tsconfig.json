{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": ["vitepress/client"],
    "baseUrl": "."
  },
  "include": [
    ".vitepress/**/*",
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue"
  ]
}
